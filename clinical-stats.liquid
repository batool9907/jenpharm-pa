<section class="py-xl bg-surface-container-low overflow-hidden relative" id="clinical-stats">
  <div class="px-margin-desktop max-w-[1440px] mx-auto relative z-10">
    <div class="grid md:grid-cols-2 gap-16 items-center">
      <div>
        <h2 class="font-display-lg text-[40px] leading-tight mb-6">24-Hour Active <br/>Moisture Retention</h2>
        <p class="text-on-surface-variant font-body-lg mb-8">
          Dermive's time-release technology ensures your skin stays hydrated from the first application until your evening routine.
        </p>
        <div class="space-y-8" id="hydration-stats">
          <div class="space-y-2">
            <div class="flex justify-between text-label-md">
              <span class="font-semibold uppercase text-primary">Hydration Levels</span>
              <span class="font-bold">98%</span>
            </div>
            <div class="h-3 w-full bg-surface-container-high rounded-full overflow-hidden">
              <div class="hydration-bar-fill h-full bg-primary-container" style="width: 98%" data-target-width="98%"></div>
            </div>
          </div>
          <div class="space-y-2">
            <div class="flex justify-between text-label-md">
              <span class="font-semibold uppercase text-primary">Barrier Strength Improvement</span>
              <span class="font-bold">84%</span>
            </div>
            <div class="h-3 w-full bg-surface-container-high rounded-full overflow-hidden">
              <div class="hydration-bar-fill h-full bg-primary-container" style="width: 84%" data-target-width="84%"></div>
            </div>
          </div>
        </div>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div class="bg-white p-8 rounded-2xl clinical-shadow border border-outline-variant/30 space-y-4">
          <span class="material-symbols-outlined text-primary text-[40px]">texture</span>
          <h4 class="font-headline-md text-[18px]">Ultra-Light Texture</h4>
          <p class="text-on-surface-variant font-label-md">Absorbs instantly. Leaves a matte, silky finish perfect under makeup.</p>
        </div>
        <div class="bg-white p-8 rounded-2xl clinical-shadow border border-outline-variant/30 mt-8 space-y-4">
          <span class="material-symbols-outlined text-primary text-[40px]">spa</span>
          <h4 class="font-headline-md text-[18px]">Soothes Sensitivity</h4>
          <p class="text-on-surface-variant font-label-md">Fragrance-free formula designed for reactive and normal skin types.</p>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Clinical Stats",
  "settings": []
}
{% endschema %}
