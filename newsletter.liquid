<section class="py-xl bg-primary text-on-primary" id="newsletter">
  <div class="px-margin-desktop max-w-[1440px] mx-auto flex flex-col md:flex-row items-center justify-between gap-8">
    <div class="space-y-4">
      <h2 class="font-headline-lg text-headline-lg text-white">Join the Clinical Care Circle</h2>
      <p class="text-white/80 font-body-lg">Get 15% off your first order and exclusive dermatologist-curated skincare tips.</p>
    </div>
    <div class="flex w-full md:w-auto gap-2">
      <input class="bg-white/10 border-white/20 text-white placeholder:text-white/60 rounded-xl px-6 py-4 w-full md:w-80 focus:ring-white/50 focus:border-white" placeholder="Enter your email" type="email"/>
      <button class="bg-white text-primary font-bold px-8 py-4 rounded-xl hover:bg-surface-container transition-all">Subscribe</button>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": []
}
{% endschema %}
