<section class="py-xl bg-surface-container-lowest" id="technology">
  <div class="px-margin-desktop max-w-[1440px] mx-auto">
    <div class="text-center mb-16 space-y-2">
      <span class="text-primary font-label-md text-label-md uppercase tracking-widest">Molecular Precision</span>
      <h2 class="font-headline-lg text-headline-lg">Advanced Formula Technology</h2>
    </div>
    <div class="grid lg:grid-cols-3 gap-12 items-center">
      <div class="space-y-12 order-2 lg:order-1">
        <div class="flex gap-6 group">
          <div class="w-16 h-16 shrink-0 rounded-2xl bg-primary-fixed flex items-center justify-center group-hover:scale-110 transition-transform">
            <span class="material-symbols-outlined text-primary text-[32px]">science</span>
          </div>
          <div>
            <h3 class="font-headline-md text-[20px] mb-2">Essential Ceramides</h3>
            <p class="text-on-surface-variant font-body-md">Restores the natural skin barrier by replenishing essential lipids lost to environmental stress.</p>
          </div>
        </div>
        <div class="flex gap-6 group">
          <div class="w-16 h-16 shrink-0 rounded-2xl bg-secondary-fixed flex items-center justify-center group-hover:scale-110 transition-transform">
            <span class="material-symbols-outlined text-secondary text-[32px]">water_drop</span>
          </div>
          <div>
            <h3 class="font-headline-md text-[20px] mb-2">Hyaluronic Acid</h3>
            <p class="text-on-surface-variant font-body-md">Micro-molecule technology that locks in 1000x its weight in water for deep epidermal hydration.</p>
          </div>
        </div>
      </div>
      <div class="order-1 lg:order-2 flex justify-center relative">
        <div class="absolute inset-0 bg-primary/5 rounded-full scale-125 blur-3xl opacity-50"></div>
        <img class="relative z-10 w-full max-w-sm drop-shadow-2xl" alt="Jenpharm Dermive Oil Free Moisturizer tube product shot" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCexhfGPpW-Dd1ri6UlAVmRPO9nhcBLOMMsCBTaOU-mgunWP237Mh-UCsTtO0uHiC4TM92q7Z7UEzv5VIOZxbQOA4W4EO05Fs7uO5cxxRc742CPT3C_ptxM97Ytkiuly53WYxhPbatffmDOlbSy264rHujE_efN-FcaDZQ160raUjGJLyV8HE3m6CGgdOBWa87yeWUmCMBokf25pZByLZLV3R4I5i2JHLZbxeY3iAezs7fC3lG9WVt17-peZU9epi6RIg25FKTP4A"/>
      </div>
      <div class="space-y-12 order-3 lg:order-3">
        <div class="flex gap-6 group">
          <div class="w-16 h-16 shrink-0 rounded-2xl bg-tertiary-fixed flex items-center justify-center group-hover:scale-110 transition-transform">
            <span class="material-symbols-outlined text-tertiary text-[32px]">wb_sunny</span>
          </div>
          <div>
            <h3 class="font-headline-md text-[20px] mb-2">SPF 20 Shield</h3>
            <p class="text-on-surface-variant font-body-md">Broad-spectrum UV filters that provide daily defense without the greasy, heavy feel of typical sunscreens.</p>
          </div>
        </div>
        <div class="flex gap-6 group">
          <div class="w-16 h-16 shrink-0 rounded-2xl bg-primary-fixed flex items-center justify-center group-hover:scale-110 transition-transform">
            <span class="material-symbols-outlined text-primary text-[32px]">check_circle</span>
          </div>
          <div>
            <h3 class="font-headline-md text-[20px] mb-2">Non-Comedogenic</h3>
            <p class="text-on-surface-variant font-body-md">Clinically formulated to ensure zero pore clogging, making it the gold standard for oily skin types.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

