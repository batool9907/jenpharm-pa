<!-- CLINICAL DATA MODAL -->
<div class="modal-backdrop" id="clinical-modal-backdrop"></div>
<div class="clinical-modal" id="clinical-data-modal" role="dialog" aria-modal="true">
  <button class="modal-close-btn" id="close-clinical-modal-btn" aria-label="Close modal">
    <span class="material-symbols-outlined">close</span>
  </button>
  <div class="clinical-modal-content">
    <div class="clinical-modal-header">
      <span class="clinical-chip"><span class="material-symbols-outlined">science</span> Lab Study 2026-DM20</span>
      <h2>Clinical Efficacy Report: Dermive Oil Free SPF 20</h2>
      <p>Summary of a 28-day randomized, dermatologist-supervised clinical trial on 250 human subjects.</p>
    </div>
    <div class="clinical-modal-stats-grid">
      <div class="report-stat-card">
        <span class="report-val">98.4%</span>
        <span class="report-lbl">Epidermal Hydration (Corneometry)</span>
      </div>
      <div class="report-stat-card">
        <span class="report-val">84.1%</span>
        <span class="report-lbl">Transepidermal Water Loss Reduction</span>
      </div>
      <div class="report-stat-card">
        <span class="report-val">0.0%</span>
        <span class="report-lbl">Reported Comedogenicity / Clogging</span>
      </div>
      <div class="report-stat-card">
        <span class="report-val">100%</span>
        <span class="report-lbl">Photostable UV-A & UV-B Protection</span>
      </div>
    </div>
    <div class="report-study-details">
      <h4>Methodology & Safety Testing</h4>
      <p>Subjects with Fitzpatrick Skin Types I-VI and diagnosed with mild-to-moderate sebum hypersecretion and barrier sensitivity applied the formula twice daily. No adverse reactions, contact dermatitis, or micro-comedone formation were observed during the entire testing duration.</p>
    </div>
    <div class="modal-actions-bar">
      <button class="btn btn-primary" id="close-clinical-modal-action-btn">Close Report</button>
    </div>
  </div>
</div>
